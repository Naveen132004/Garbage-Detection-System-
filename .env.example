# Copy to .env (or set these in your shell) before starting app1.py.
# Never commit real values.

# MongoDB Atlas connection string. Leave empty to save results to data/detections.json instead.
MONGO_URI=
MONGO_DB=garbage_db

# Optional: enables Satellite / Hybrid / Terrain layers on the map.
GOOGLE_MAPS_API_KEY=

# Optional: stores real weather with each report.
OPENWEATHER_API_KEY=

# Optional settings
MODEL_PATH=Weights/best.pt
CONFIDENCE_THRESHOLD=0.3
APP_TIMEZONE=Asia/Kolkata
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
